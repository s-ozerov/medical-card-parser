<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox maxHeight="541.0" maxWidth="930.0" minHeight="-Infinity" minWidth="-Infinity" prefHeight="540.0" prefWidth="930.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.work.service.view.controller.MainController">
    <VBox prefHeight="457.0" prefWidth="310.0">
        <children>
            <VBox prefHeight="130.0" prefWidth="310.0">
                <children>
                    <AnchorPane prefHeight="90.0" prefWidth="310.0">
                        <children>
                            <Button fx:id="downloadButton" layoutX="177.0" layoutY="12.0" mnemonicParsing="false" prefHeight="82.0" prefWidth="52.0">
                                <font>
                                    <Font name="Georgia" size="12.0" />
                                </font>
                        <tooltip>
                           <Tooltip text="Сохранить результат в файл Excel" />
                        </tooltip>
                            </Button>
                            <Button fx:id="openButton" alignment="CENTER" contentDisplay="CENTER" layoutX="14.0" layoutY="13.0" mnemonicParsing="false" prefHeight="32.0" prefWidth="32.0" textAlignment="CENTER">
                                <font>
                                    <Font name="Georgia" size="12.0" />
                                </font>
                                <tooltip>
                                    <Tooltip text="Обработать 1 файл DOC или DOCX" />
                                </tooltip>
                            </Button>
                            <Button fx:id="openMultipleButton" alignment="CENTER" contentDisplay="CENTER" layoutX="14.0" layoutY="58.0" mnemonicParsing="false" prefHeight="32.0" prefWidth="32.0" textAlignment="CENTER">
                                <font>
                                    <Font name="Georgia" size="12.0" />
                                </font>
                                <tooltip>
                                    <Tooltip text="Обработка нескольких файлов DOC или DOCX которые находятся в папке" />
                                </tooltip>
                            </Button>
                            <Button fx:id="startButton" alignment="CENTER" contentDisplay="CENTER" layoutX="58.0" layoutY="13.0" mnemonicParsing="false" prefHeight="81.0" prefWidth="106.0" text="Получить" textAlignment="CENTER" wrapText="true">
                                <font>
                                    <Font name="Georgia" size="12.0" />
                                </font>
                            </Button>
                        </children>
                    </AnchorPane>
                </children>
            </VBox>
            <VBox fillWidth="false" prefHeight="462.0" prefWidth="310.0">
                <children>
                    <AnchorPane prefHeight="461.0" prefWidth="310.0" stylesheets="@../css/standart-list.css">
                        <children>
                            <ListView fx:id="fileList" layoutX="11.0" layoutY="5.0" prefHeight="428.0" prefWidth="287.0" styleClass="../css/standart-list.css">
                                <cursor>
                                    <Cursor fx:constant="DEFAULT" />
                                </cursor>
                            </ListView>
                        </children>
                    </AnchorPane>
                </children>
            </VBox>
        </children>
    </VBox>
    <VBox prefHeight="498.0" prefWidth="610.0">
        <children>
            <TabPane prefHeight="538.0" prefWidth="610.0" tabClosingPolicy="UNAVAILABLE">
                <tabs>
                    <Tab text="Журнал">
                        <content>
                            <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="514.0" prefWidth="610.0">
                                <children>
                                    <ListView fx:id="logView" layoutX="5.0" layoutY="14.0" prefHeight="490.0" prefWidth="599.0" />
                                    <Button fx:id="clearLogButton" layoutX="539.0" layoutY="440.0" mnemonicParsing="false" prefHeight="48.0" prefWidth="48.0" textAlignment="CENTER" wrapText="true">
                                        <font>
                                            <Font name="Georgia" size="10.0" />
                                        </font>
                                        <tooltip>
                                            <Tooltip text="Очистка журнала" />
                                        </tooltip>
                                    </Button>
                                </children>
                            </AnchorPane>
                        </content>
                    </Tab>
                    <Tab text="Результат">
                        <content>
                            <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                        <children>
                                  <Label fx:id="countNameLabel" alignment="TOP_LEFT" layoutX="14.0" layoutY="14.0" prefHeight="19.0" prefWidth="99.0" text="Кол-во файлов:" textFill="#4a89ff" textOverrun="WORD_ELLIPSIS" wrapText="true">
                                      <font>
                                          <Font name="Segoe UI" size="12.0" />
                                      </font>
                                  </Label>
                                  <Label fx:id="countLabel" alignment="TOP_LEFT" layoutX="113.0" layoutY="14.0" prefHeight="19.0" prefWidth="39.0" textFill="#4a89ff" textOverrun="WORD_ELLIPSIS" wrapText="true">
                                      <font>
                                          <Font name="Segoe UI" size="12.0" />
                                      </font>
                                  </Label>
                                  <Button fx:id="showErrorsButton" layoutX="14.0" layoutY="45.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="126.0" text="Результат">
                                      <font>
                                          <Font name="Georgia" size="10.0" />
                                      </font>
                                  </Button>
                        </children></AnchorPane>
                        </content>
                    </Tab>
                    <Tab text="Настройки">
                        <content>
                            <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                                <children>
                                    <ChoiceBox fx:id="themeBox" layoutX="187.0" layoutY="13.0" prefHeight="26.0" prefWidth="118.0" />
                                    <Label layoutX="14.0" layoutY="18.0" text="Изменить текущую тему:" />
                           <VBox layoutX="14.0" layoutY="62.0" prefHeight="141.0" prefWidth="387.0">
                              <children>
                                 <Label text="Выберете колонки, которые будут отображаться в таблице:" />
                                 <CheckBox fx:id="monthCB" mnemonicParsing="false" selected="true" text="Месяц" />
                                 <CheckBox fx:id="microorganismsCB" mnemonicParsing="false" selected="true" text="Бактерии" />
                                 <CheckBox fx:id="divisionCB" mnemonicParsing="false" selected="true" text="Отделение" />
                                 <CheckBox fx:id="bioMaterialCB" mnemonicParsing="false" text="Биоматериал" />
                                 <CheckBox fx:id="receiveMaterialDateCB" mnemonicParsing="false" text="Дата поступления материала" />
                                 <CheckBox fx:id="filenameCB" mnemonicParsing="false" text="Название файла" />
                                 <CheckBox fx:id="patientCB" mnemonicParsing="false" text="Пациент" />
                                 <CheckBox fx:id="diagnoseCB" mnemonicParsing="false" text="Диагноз" />
                                 <CheckBox fx:id="ibCB" mnemonicParsing="false" text="ИБ" />
                                 <CheckBox fx:id="numberAnalyzeCB" mnemonicParsing="false" text="№ анализа" />
                              </children>
                           </VBox>
                           <Button fx:id="saveSettingsButton" alignment="CENTER" contentDisplay="CENTER" layoutX="409.0" layoutY="11.0" mnemonicParsing="false" prefHeight="32.0" prefWidth="186.0" text="Сохранить изменения" textAlignment="CENTER" wrapText="true" />
                                </children>
                            </AnchorPane>
                        </content>
                    </Tab>
                </tabs>
            </TabPane>
        </children>
    </VBox>
</HBox>
