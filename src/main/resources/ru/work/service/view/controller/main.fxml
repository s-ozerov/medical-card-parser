<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<HBox maxHeight="541.0" maxWidth="930.0" minHeight="-Infinity" minWidth="-Infinity" prefHeight="540.0" prefWidth="930.0"
      xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.work.service.view.controller.MainController">
    <VBox prefHeight="457.0" prefWidth="310.0">
        <children>
            <VBox prefHeight="49.0" prefWidth="310.0">
                <children>
                    <AnchorPane prefHeight="156.0" prefWidth="310.0">
                        <children>
                            <Button fx:id="openButton" layoutX="14.0" layoutY="11.0" mnemonicParsing="false"
                                    prefHeight="26.0" prefWidth="126.0" text="один файл...">
                                <font>
                                    <Font name="Georgia" size="12.0"/>
                                </font>
                                <tooltip>
                                    <Tooltip text="Обработать 1 файл DOC или DOCX"/>
                                </tooltip>
                            </Button>
                            <Button fx:id="openMultipleButton" layoutX="169.0" layoutY="11.0" mnemonicParsing="false"
                                    prefHeight="26.0" prefWidth="126.0" text="папка...">
                                <font>
                                    <Font name="Georgia" size="12.0"/>
                                </font>
                                <tooltip>
                                    <Tooltip text="Обработка нескольких файлов DOC или DOCX которые находятся в папке"/>
                                </tooltip>
                            </Button>
                        </children>
                    </AnchorPane>
                </children>
            </VBox>
            <VBox fillWidth="false" prefHeight="507.0" prefWidth="314.0">
                <children>
                    <AnchorPane prefHeight="482.0" prefWidth="310.0" stylesheets="@../css/standart-list.css">
                        <children>
                            <ListView fx:id="fileList" layoutX="11.0" layoutY="48.0" prefHeight="383.0"
                                      prefWidth="287.0" styleClass="../css/standart-list.css">
                                <cursor>
                                    <Cursor fx:constant="DEFAULT"/>
                                </cursor>
                            </ListView>
                            <Button fx:id="startButton" layoutX="14.0" layoutY="441.0" mnemonicParsing="false"
                                    prefHeight="26.0" prefWidth="126.0" text="Получить">
                                <font>
                                    <Font name="Georgia" size="12.0"/>
                                </font>
                            </Button>
                            <Button fx:id="downloadButton" layoutX="169.0" layoutY="441.0" mnemonicParsing="false"
                                    prefHeight="26.0" prefWidth="126.0" text="Сохранить как...">
                                <font>
                                    <Font name="Georgia" size="12.0"/>
                                </font>
                            </Button>
                            <Label fx:id="countLabel" alignment="TOP_LEFT" layoutX="113.0" layoutY="23.0"
                                   prefHeight="19.0" prefWidth="39.0" textFill="#4a89ff" textOverrun="WORD_ELLIPSIS"
                                   wrapText="true">
                                <font>
                                    <Font name="Segoe UI" size="12.0"/>
                                </font>
                            </Label>
                            <Label fx:id="countNameLabel" alignment="TOP_LEFT" layoutX="14.0" layoutY="23.0"
                                   prefHeight="19.0" prefWidth="99.0" text="Кол-во файлов:" textFill="#4a89ff"
                                   textOverrun="WORD_ELLIPSIS" wrapText="true">
                                <font>
                                    <Font name="Segoe UI" size="12.0"/>
                                </font>
                            </Label>
                            <Button fx:id="showErrorsButton" layoutX="169.0" layoutY="16.0" mnemonicParsing="false"
                                    prefHeight="26.0" prefWidth="126.0" text="Результат">
                                <font>
                                    <Font name="Georgia" size="10.0"/>
                                </font>
                            </Button>
                        </children>
                    </AnchorPane>
                </children>
            </VBox>
        </children>
    </VBox>
    <VBox prefHeight="498.0" prefWidth="610.0">
        <children>
            <TabPane prefHeight="537.0" prefWidth="610.0" tabClosingPolicy="UNAVAILABLE">
                <tabs>
                    <Tab text="Журнал">
                        <content>
                            <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="231.0" prefWidth="610.0">
                                <children>
                                    <ListView fx:id="logView" layoutX="5.0" layoutY="14.0" prefHeight="490.0"
                                              prefWidth="599.0"/>
                                    <Button fx:id="clearLogButton" layoutX="556.0" layoutY="444.0"
                                            mnemonicParsing="false" prefHeight="42.0" prefWidth="39.0"
                                            textAlignment="CENTER" wrapText="true">
                                        <font>
                                            <Font name="Georgia" size="10.0"/>
                                        </font>
                                        <tooltip>
                                            <Tooltip text="Очистка журнала"/>
                                        </tooltip>
                                    </Button>
                                </children>
                            </AnchorPane>
                        </content>
                    </Tab>
                    <Tab text="Результат">
                        <content>
                            <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0"/>
                        </content>
                    </Tab>
                    <Tab text="Настройки">
                        <content>
                            <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                                <children>
                                    <ChoiceBox fx:id="themeBox" layoutX="115.0" layoutY="13.0" prefHeight="26.0"
                                               prefWidth="117.0"/>
                                    <Label layoutX="14.0" layoutY="18.0" text="Текущая тема:"/>
                                </children>
                            </AnchorPane>
                        </content>
                    </Tab>
                </tabs>
            </TabPane>
        </children>
    </VBox>
</HBox>
